{
  "schema_version": 1,
  "toolchain_version": "2026-10-12.1",
  "profile_groups": {
    "core": [
      "core"
    ],
    "build": [
      "core",
      "build"
    ],
    "media": [
      "core",
      "media"
    ],
    "full": [
      "core",
      "build",
      "media"
    ]
  },
  "packages": {
    "core": [
      "ca-certificates",
      "curl",
      "wget",
      "git",
      "gh",
      "jq",
      "yq",
      "unzip",
      "zip",
      "rsync",
      "ripgrep",
      "fd-find",
      "fzf",
      "tree",
      "file",
      "lsof",
      "strace",
      "procps",
      "net-tools",
      "netcat-openbsd",
      "dnsutils",
      "sqlite3",
      "shellcheck",
      "python3",
      "python3-pip"
    ],
    "build": [
      "build-essential",
      "golang-go",
      "rustc",
      "cargo",
      "default-jdk-headless",
      "cmake",
      "ninja-build",
      "pkg-config",
      "python3-venv",
      "python3-dev",
      "python3-setuptools",
      "python3-wheel",
      "git-lfs",
      "clang",
      "gdb",
      "perl",
      "libclang-dev",
      "llvm-dev",
      "nasm",
      "libssl-dev",
      "libsqlite3-dev",
      "zlib1g-dev",
      "libffi-dev",
      "libunwind-dev"
    ],
    "media": [
      "ffmpeg",
      "imagemagick"
    ]
  },
  "commands": {
    "core": [
      "git",
      "gh",
      "node",
      "npm",
      "python3",
      "rg",
      "fd",
      "jq",
      "sqlite3",
      "shellcheck"
    ],
    "build": [
      "cmake",
      "ninja",
      "gcc",
      "clang",
      "gdb",
      "git-lfs",
      "go",
      "rustc",
      "cargo",
      "java",
      "javac",
      "actionlint"
    ],
    "media": [
      "ffmpeg",
      "convert",
      "ffprobe",
      "identify"
    ]
  },
  "pkg_config_modules": {
    "core": [],
    "build": [],
    "media": []
  },
  "pkg_config_path": [],
  "node": {
    "source": "actions/setup-node latest stable"
  },
  "thresholds": {
    "disk_free_gb": 10,
    "inode_free_percent": 5
  },
  "actionlint": {
    "latest_release": {
      "repo": "rhysd/actionlint",
      "asset_template": "actionlint_{version}_linux_{arch}.tar.gz",
      "architectures": {
        "x86_64": "amd64",
        "aarch64": "arm64"
      }
    }
  },
  "goss": {
    "latest_release": {
      "repo": "goss-org/goss",
      "asset_template": "goss_{version}_linux_{arch}.tar.gz",
      "architectures": {
        "x86_64": "x86_64",
        "aarch64": "arm64"
      }
    }
  },
  "network": {
    "critical": [
      {
        "kind": "dns",
        "host": "github.com"
      },
      {
        "kind": "github_api",
        "endpoint": "/rate_limit"
      }
    ],
    "advisory": [
      {
        "kind": "http",
        "url": "https://registry.npmjs.org"
      },
      {
        "kind": "http",
        "url": "https://pypi.org"
      }
    ]
  }
}
