#!/usr/bin/env bash
set -Eeuo pipefail

HOST="${AGENT_GITHUB_HOST:-github.com}"

case "${1:-}" in
  get)
    IFS= read -r server
    case "$server" in
      ghcr.io|https://ghcr.io|https://ghcr.io/v1/) ;;
      *) echo "unsupported registry: $server" >&2; exit 1 ;;
    esac
    login="$(gh api user --jq .login)"
    token="$(gh auth token --hostname "$HOST")"
    [[ -n "$login" && -n "$token" ]] || exit 1
    printf '%s\0%s\0%s\0' "$server" "$login" "$token" |
      python3 -c 'import json,sys; p=sys.stdin.buffer.read().split(b"\0"); print(json.dumps({"ServerURL":p[0].decode(),"Username":p[1].decode(),"Secret":p[2].decode()}))'
    ;;
  list)
    login="$(gh api user --jq .login)"
    python3 -c 'import json,sys; print(json.dumps({"ghcr.io":sys.argv[1]}))' "$login"
    ;;
  erase)
    cat >/dev/null
    ;;
  store)
    cat >/dev/null
    echo 'github-cli credential helper is read-only; credentials are owned by GitHub CLI' >&2
    exit 1
    ;;
  *)
    echo 'Usage: docker-credential-github-cli {get|list|erase|store}' >&2
    exit 1
    ;;
esac
